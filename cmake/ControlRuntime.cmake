include_guard(GLOBAL)
get_filename_component(RLC_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set_property(GLOBAL PROPERTY RLC_SOURCE_ROOT "${RLC_ROOT}")
find_package(Threads REQUIRED)
add_library(rlc-runtime STATIC "${RLC_ROOT}/deps/tinyxml2/tinyxml2.cpp" "${RLC_ROOT}/source/control/WebSocket.cpp")
target_compile_features(rlc-runtime PUBLIC cxx_std_17)
set_target_properties(rlc-runtime PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(rlc-runtime PUBLIC
    "${RLC_ROOT}/deps" "${RLC_ROOT}/deps/tinyxml2"
    "${RLC_ROOT}/deps/websocketpp" "${RLC_ROOT}/deps/asio/asio/include")
target_compile_definitions(rlc-runtime PUBLIC ASIO_STANDALONE _WEBSOCKETPP_CPP11_STL_)
target_link_libraries(rlc-runtime PUBLIC Threads::Threads)
if(WIN32)
    target_sources(rlc-runtime PRIVATE "${RLC_ROOT}/source/control/PlatformWindows.cpp")
    target_compile_definitions(rlc-runtime PUBLIC NOMINMAX _WIN32_WINNT=0x0601)
    target_link_libraries(rlc-runtime PUBLIC ws2_32 mswsock shell32 ole32)
elseif(APPLE)
    enable_language(OBJCXX)
    target_sources(rlc-runtime PRIVATE "${RLC_ROOT}/source/control/PlatformMac.mm")
    set_target_properties(rlc-runtime PROPERTIES OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
    target_compile_options(rlc-runtime PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
    target_link_libraries(rlc-runtime PUBLIC "-framework Foundation")
elseif(RLC_CLOUD_TEST_PLATFORM)
    # Explicit test-only OS adapter. Production plugins remain Windows/macOS only.
    target_sources(rlc-runtime PRIVATE "${RLC_ROOT}/tests/platform_testing.cpp")
else()
    message(FATAL_ERROR "Layer Control supports Windows and macOS only")
endif()
