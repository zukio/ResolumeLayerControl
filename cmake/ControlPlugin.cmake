include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ControlRuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GeneratePlugin.cmake")
function(rlc_add_plugin target name)
    get_property(RLC_ROOT GLOBAL PROPERTY RLC_SOURCE_ROOT)
    if(NOT "${ARGV2}" STREQUAL "NO_DEFINITION")
        rlc_generate_definition(${name})
    endif()
    add_library(${target} MODULE ${name}.cpp)
    if(NOT "${ARGV2}" STREQUAL "NO_DEFINITION")
        add_dependencies(${target} generate-${name})
    endif()
    target_link_libraries(${target} PRIVATE ffgl::sdk rlc-runtime)
    set_target_properties(${target} PROPERTIES OUTPUT_NAME ${name} PREFIX "")
    if(WIN32)
        if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
            message(FATAL_ERROR "Layer Control Windows builds require x64")
        endif()
        set_target_properties(${target} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY "${RLC_ROOT}/binaries/x64/$<CONFIG>"
            LIBRARY_OUTPUT_DIRECTORY "${RLC_ROOT}/binaries/x64/$<CONFIG>"
            PDB_OUTPUT_DIRECTORY "${RLC_ROOT}/binaries/x64/$<CONFIG>")
        target_sources(${target} PRIVATE "${RLC_ROOT}/build/windows/FFGLPlugins.def")
    elseif(APPLE)
        set_target_properties(${target} PROPERTIES BUNDLE TRUE BUNDLE_EXTENSION bundle
            MACOSX_BUNDLE_INFO_PLIST "${RLC_ROOT}/cmake/ControlPlugin-Info.plist.in"
            CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
        target_link_options(${target} PRIVATE "-Wl,-exported_symbol,_plugMain")
    endif()
endfunction()
